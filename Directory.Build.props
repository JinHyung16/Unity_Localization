<Project>

  <PropertyGroup>
    <!-- 버전은 Unity 패키지의 package.json 하나로 정한다. DLL 과 exe 가 같은 번호를 단다 -->
    <UnityPackageJson>$(MSBuildThisFileDirectory)Packages/com.translation.unity/package.json</UnityPackageJson>
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(UnityPackageJson)')), '"version"\s*:\s*"[^"]+"').Value), '^.*"([^"]+)"$', '$1'))</Version>
    <!-- Unity 가 소스를 직접 컴파일하지 않으므로 C# 9 에 묶이지 않는다. CI 의 .NET 8 SDK 가 지원하는 최신 버전 -->
    <LangVersion>12.0</LangVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>localization;translation;i18n;unity;gamedev</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
